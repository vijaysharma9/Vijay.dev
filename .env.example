# Public site URL (used for FormSubmit AJAX Origin/Referer; match your deployed domain)
NEXT_PUBLIC_SITE_URL=https://www.hiredevelopershop.com

# Contact form: `resend` (forces Resend; requires all RESEND_* below) or `formsubmit`
# CONTACT_FORM_PROVIDER=formsubmit

# FormSubmit.co — inbox for contact form (see README: one-time email activation)
FORM_SUBMIT_TO_EMAIL=you@example.com

# Optional: Resend (preferred when API key + from + to are set)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_TO_EMAIL=
